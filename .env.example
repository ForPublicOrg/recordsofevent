# Copy to .env for local development, or add these in Vercel → Project → Settings → Environment Variables.
# Locally, everything is optional: without them the dev server uses an embedded database and a local folder.

# --- Required in production ---
# Postgres connection string (Neon via the Vercel Marketplace sets this for you).
DATABASE_URL=
# S3-compatible storage for the videos. Cloudflare R2 is recommended (no fees for viewers watching).
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=recordsofevent
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Password for /admin (moderation). Use a long random one.
ADMIN_PASSWORD=
# Random secret for signing moderator sessions and hashing IPs for rate limits: `openssl rand -hex 32`
APP_SECRET=

# --- Optional ---
# Public address, used in share links and QR codes when set (otherwise taken from the request).
SITE_URL=https://recordsofevent.com
SITE_NAME=Records of Event
# "pre" (default): a moderator approves each video before it is public. "post": public immediately.
MODERATION=pre
# Shown on the policy pages and after a report is sent.
CONTACT_EMAIL=
OPERATOR_NAME=
# Link to the source code shown in the footer.
REPO_URL=
# Limits
MAX_FILE_GB=5
DAILY_UPLOAD_GB=50
# Videos can also be added by pasting a link (Google Drive, Dropbox, OneDrive, direct file links).
# The server copies them into storage, which uses function time and bandwidth. "off" hides the option.
LINK_IMPORTS=on
# Searchable places on the event and upload forms, from free services built on open map data:
# Open-Meteo's geocoder (towns and cities) and komoot's Photon (OpenStreetMap: streets, squares,
# landmarks). Searches go through this server. "off" turns the place boxes back into plain text
# (countries are always picked from the built-in list). PLACES_URL points at your own Photon server.
PLACES=on
PLACES_URL=
# Vercel sends this automatically to the daily cleanup job when set.
CRON_SECRET=
